---
import { appLoginUrl, appPrivacyUrl, appTermsUrl } from '../lib/app';
import { CONTACT_PATH } from '../lib/contact';
import { NAV_LINKS } from '../lib/nav';
---

<footer class="ftr">
	<div class="wrap">
		<div class="footer-row">
			<a href="/"><img src="/images/obii_logo.png" alt="OBII" width="750" height="201" loading="lazy" decoding="async" /></a>
			<div class="footer-nav">
				{NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
				<a href={appLoginUrl}>Log in</a>
				<a href={appTermsUrl}>Terms</a>
				<a href={appPrivacyUrl}>Privacy</a>
				<a href={CONTACT_PATH}>Contact</a>
			</div>
		</div>
		<p class="footer-legal">OBII helps independent investors research source-linked expert commentary. Content is general information, not personal financial advice.</p>
	</div>
</footer>
