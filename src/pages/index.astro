<script>
	import { initEpisodePlayers } from '../scripts/episodePlayer';

	initEpisodePlayers();

	const MOBILE_CTA_SCROLL_THRESHOLD = 780;
	const mobileCta = document.querySelector('.mobile-cta');
	window.addEventListener(
		'scroll',
