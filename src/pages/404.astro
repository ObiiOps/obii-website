---
import SubPage from '../layouts/SubPage.astro';

const title = 'Page not found | OBII';
const description = 'The page you were looking for could not be found. Head back to the OBII homepage or explore how OBII works.';
---

<SubPage title={title} description={description} noindex>
	<section slot="hero" class="hero"><div class="wrap"><div class="eyebrow light">PAGE NOT FOUND</div>
	<h1>We couldn’t find <em>that page.</em></h1><p class="lede">The link may be out of date or the page may have moved. Try one of these instead.</p><div class="hero-actions"><a class="btn" href="/">Back to the homepage <span>→</span></a><a class="btn ghost" href="/how-it-works/">How OBII works</a></div>
	</div>
	</section>
</SubPage>
