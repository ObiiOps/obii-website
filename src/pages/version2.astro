import ObiiLogo from '../components/ObiiLogo.astro';
import EpisodeVideoArt from '../components/EpisodeVideoArt.astro';
import kochPortrait from '../assets/koch_no-bkg.png';
import nadinePortrait from '../assets/nadine_no-bkg.png';
import kochCard from '../assets/koch-card.png';
import nadineCard from '../assets/nadine-card.png';
import { appLoginUrl, appRegisterUrl } from '../lib/app';

const companies = [
	{ ticker: 'BHP', name: 'BHP Group', color: '#ef8d22' },
	{ ticker: 'CBA', name: 'Commonwealth Bank', color: '#d4a017' },
	{ ticker: 'CSL', name: 'CSL Limited', color: '#db4048' },
	{ ticker: 'WES', name: 'Wesfarmers', color: '#1f8a5b' },
	{ ticker: 'MQG', name: 'Macquarie Group', color: '#5b6fd6' },
];

const episodeUrl = 'https://ausbiz.com.au/media/the-call-2nd-november-bhp-bsl-jbh-wor-tua-srg-xro-qbe-csl-gmg?videoId=52082';
const episodePoster = 'https://db21uid68tafd.cloudfront.net/vod-image/001f6503-160d-4b8d-8ba2-0fa0b86c1001/1793589018_Screenshot%202026-11-02%20141001.png';
const episodeVideoSrc =
	'https://d3ocr0urz6zrlt.cloudfront.net/001f6503-160d-4b8d-8ba2-0fa0b86c1001/vimondio_video_1920x1080_10000.mp4';

const faqs = [
	['What exactly is OBII?', 'OBII is a paid expert investment intelligence membership. It helps self-directed investors research expert views on companies they follow, explore available reasoning and verify original dated interviews.'],
	['Why would I use OBII month after month?', 'New expert commentary gives you a reason to return to the companies and commentators you follow. Your plan’s research tools help you keep the record organised and inspect new original sources.'],
	['What does the investment intelligence actually do?', 'It organises available expert commentary around companies and people, connects context and source dates, and helps you examine what was said. It does not make investment decisions for you.'],
	['How is it different from free ausbiz?', 'ausbiz lets you watch expert interviews for free. OBII is a paid research membership for searching expert commentary, exploring available reasoning and accessing dated original sources.'],
	['Do I need a card for the trial?', 'No. The advertised seven-day free trial does not require a credit card.'],
	['Does OBII provide personal financial advice?', 'No. OBII provides general expert commentary and source-linked research information, not personalised financial advice.'],
];

const steps = [
	['01', 'Find', 'Search real market commentary on the companies and experts you already follow.'],
	['02', 'Understand', 'Go beyond a sound bite with the explanation and context available in the record.'],
	['03', 'Verify', 'Check the date and original ausbiz recording before making up your own mind.'],
];
---

