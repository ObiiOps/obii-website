<script>
	const menu = document.querySelector('.menu');
	const panel = document.querySelector('.nav-panel');
	menu?.addEventListener('click', () => {
		const open = panel?.hasAttribute('hidden');
		if (open) panel?.removeAttribute('hidden');
		else panel?.setAttribute('hidden', '');
		menu.setAttribute('aria-expanded', String(Boolean(open)));
	});
	panel?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			panel.setAttribute('hidden', '');
			menu?.setAttribute('aria-expanded', 'false');
		});
	});

	const SLOT_COUNT = 5;
	const ROTATE_MS = 4000;

	function initHeroCardCarousel() {
		const stage = document.querySelector('[data-hero-cards]');
		if (!(stage instanceof HTMLElement)) return;

		const prevTimer = Number(stage.dataset.carouselTimer || 0);
		if (prevTimer) window.clearInterval(prevTimer);
		delete stage.dataset.carouselTimer;

		const cards = [...stage.querySelectorAll('.float-card')];
		if (cards.length !== SLOT_COUNT) return;

		const carousel = stage.carousel ?? {
			slots: cards.map((card) => Number(card.dataset.slot ?? 0)),
			reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
		};
		stage.carousel = carousel;
		carousel.cards = cards;
		carousel.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		carousel.slots = cards.map((card, index) => Number(card.dataset.slot ?? index));

		const applySlots = () => {
			carousel.cards.forEach((card, index) => {
				card.dataset.slot = String(carousel.slots[index]!);
			});
		};

		const rotate = () => {
			for (let i = 0; i < carousel.slots.length; i++) {
				carousel.slots[i] = (carousel.slots[i]! + 1) % SLOT_COUNT;
			}
			applySlots();
		};

		carousel.rotate = rotate;
		applySlots();

		if (!carousel.reducedMotion) {
			stage.dataset.carouselTimer = String(window.setInterval(() => stage.carousel?.rotate(), ROTATE_MS));
		}
	}

	initHeroCardCarousel();
	document.addEventListener('astro:page-load', initHeroCardCarousel);
</script>

<style>
	.campaign {
		--ink: #111111;
		--muted: #64748b;
		--line: #e6ebf0;
		--accent: #22d3ee;
		--accent-ink: #0b1820;
		--green: #1b4332;
		--dark: #15212a;
		--surface: #1c2c38;
		--surface-2: #243744;
		--soft: #f4f7f8;
		color: var(--ink);
		background: #fff;
		font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
	}
	.shell {
		width: min(1120px, calc(100% - 48px));
		margin-inline: auto;
	}
	.section { padding: 96px 0; }
	.eyebrow {
		margin: 0 0 14px;
		color: #64748b;
		font-size: 13px;
		font-weight: 600;
		letter-spacing: .12em;
		text-transform: uppercase;
	}
	h1, h2, h3 { margin: 0; font-weight: 500; letter-spacing: -.04em; }
	h2 { font-size: clamp(34px, 4vw, 48px); line-height: 1.12; }
	p { margin: 0; }
	.center { max-width: 720px; margin: 0 auto 48px; text-align: center; }
	.center p:not(.eyebrow) { margin-top: 18px; color: var(--muted); font-size: 17px; line-height: 1.6; }
	.light-copy, .light-copy p, .light-copy .eyebrow { color: #d5dee6; }
	.light-copy h2, .light-copy h3 { color: white; }
	.light-copy .eyebrow { color: #94a3b8; }

	.pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		min-height: 42px;
		padding: 0 18px;
		border-radius: 999px;
		font-size: 14px;
		font-weight: 600;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
	}
	.pill i { font-style: normal; }
	.pill-cyan { background: var(--accent); color: var(--accent-ink); }
	.pill-green { background: var(--green); color: white; }
	.pill-ghost { border: 1px solid rgba(255,255,255,.45); color: white; background: transparent; }
	.logo { display: inline-flex; line-height: 0; text-decoration: none; }

	.top { background: var(--dark); color: white; }
	.site-header { position: sticky; top: 0; z-index: 20; background: rgba(21, 33, 42, .92); backdrop-filter: blur(16px); }
	.nav-wrap { display: flex; align-items: center; height: 80px; gap: 32px; }
	.nav-links { display: flex; align-items: center; gap: 28px; margin-left: auto; }
