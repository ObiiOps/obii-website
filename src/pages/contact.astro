---
import SubPage from '../layouts/SubPage.astro';
import { appPrivacyUrl } from '../lib/app';
import {
	CONTACT_EMAIL,
	CONTACT_FORM_NAME,
	CONTACT_THANKS_PATH,
	SUPPORT_EMAIL,
	contactMailto,
	supportMailto,
} from '../lib/contact';

const title = 'Contact OBII | Get in touch with the team';
const description = 'Questions about OBII, your membership or the free trial? Send the OBII team a message and we will be in touch.';

const HONEYPOT_FIELD = 'bot-field';
const NAME_MAX_LENGTH = 100;
const MESSAGE_MAX_LENGTH = 3000;
---

<SubPage title={title} description={description}>
	<section slot="hero" class="hero"><div class="wrap"><div class="eyebrow light">CONTACT</div>
	<h1>Get in touch with <em>the OBII team.</em></h1><p class="lede">Have a question about OBII, your membership or the free trial? Send us a message and we’ll be in touch.</p>
	</div>
	</section>
	<main><section class="section alt"><div class="wrap"><div class="faq-layout">
	<form class="contact-form" name={CONTACT_FORM_NAME} method="POST" action={CONTACT_THANKS_PATH} data-netlify="true" netlify-honeypot={HONEYPOT_FIELD}>
		<input type="hidden" name="form-name" value={CONTACT_FORM_NAME} />
		<input type="hidden" name="subject" value="OBII website enquiry" />
		<p hidden><label>Leave this field empty <input name={HONEYPOT_FIELD} tabindex="-1" autocomplete="off" /></label></p>
		<h2>Send us a message</h2>
		<div class="field"><label for="contact-name">Your name</label><input id="contact-name" name="name" type="text" autocomplete="name" maxlength={NAME_MAX_LENGTH} required /></div>
		<div class="field"><label for="contact-email">Email address</label><input id="contact-email" name="email" type="email" autocomplete="email" required /></div>
		<div class="field"><label for="contact-message">How can we help?</label><textarea id="contact-message" name="message" rows="6" maxlength={MESSAGE_MAX_LENGTH} required></textarea></div>
		<button class="btn" type="submit">Send message <span>→</span></button>
		<p class="contact-note">We’ll only use your details to reply to your message. See our <a href={appPrivacyUrl}>privacy policy</a>.</p>
	</form>
	<aside class="faq-aside"><div class="eyebrow">PREFER EMAIL?</div>
	<h3>Email the team directly.</h3><p>General enquiries<br /><a class="contact-email" href={contactMailto}>{CONTACT_EMAIL}</a></p><p>Help with your membership<br /><a class="contact-email" href={supportMailto}>{SUPPORT_EMAIL}</a></p><p style="margin-bottom:0"><a class="contact-email" href="/faqs/">Read the FAQs →</a></p></aside>
	</div>
	</div>
	</section>
	</main>
</SubPage>
