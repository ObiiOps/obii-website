---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import AusbizLogo from '../components/AusbizLogo.astro';
import ObiiLogo from '../components/ObiiLogo.astro';
import PlayArrowIcon from '../components/PlayArrowIcon.astro';
import EpisodeVideoArt from '../components/EpisodeVideoArt.astro';
import { appLoginUrl, appRegisterUrl } from '../lib/app';
import kochPortrait from '../assets/koch_no-bkg.png';
import nadinePortrait from '../assets/nadine_no-bkg.png';

const companies = [
	{ ticker: 'BHP', name: 'BHP Group', color: '#ef8d22' },
	{ ticker: 'CBA', name: 'Commonwealth Bank', color: '#f1c62d' },
	{ ticker: 'CSL', name: 'CSL Limited', color: '#db4048' },
	{ ticker: 'WES', name: 'Wesfarmers', color: '#36a872' },
	{ ticker: 'MQG', name: 'Macquarie Group', color: '#7072c9' },
];

const episodeUrl = 'https://ausbiz.com.au/media/the-call-2nd-november-bhp-bsl-jbh-wor-tua-srg-xro-qbe-csl-gmg?videoId=52082';
const episodePoster = 'https://db21uid68tafd.cloudfront.net/vod-image/001f6503-160d-4b8d-8ba2-0fa0b86c1001/1793589018_Screenshot%202026-11-02%20141001.png';
const episodeVideoSrc =
	'https://d3ocr0urz6zrlt.cloudfront.net/001f6503-160d-4b8d-8ba2-0fa0b86c1001/vimondio_video_1920x1080_10000.mp4';

const faqs = [
	['What exactly is OBII?', 'OBII is a paid expert investment intelligence membership. It helps self-directed investors research expert views on companies they follow, explore available reasoning and verify original dated interviews.'],
	['Why would I use OBII month after month?', 'New expert commentary gives you a reason to return to the companies and commentators you follow. Your plan’s research tools help you keep the record organised and inspect new original sources.'],
	['What does the investment intelligence actually do?', 'It organises available expert commentary around companies and people, connects context and source dates, and helps you examine what was said. It does not make investment decisions for you.'],
	['How is it different from free ausbiz?', 'ausbiz lets you watch expert interviews for free. OBII is a paid research membership for searching expert commentary, exploring available reasoning and accessing dated original sources.'],
	['Do I need a card for the trial?', 'No. The advertised seven-day free trial does not require a credit card.'],
	['Does OBII provide personal financial advice?', 'No. OBII provides general expert commentary and source-linked research information, not personalised financial advice.'],
];
---

<Layout noindex extraFonts>
	<header class="site-header">
		<div class="shell nav-wrap">
			<a class="logo" href="#" aria-label="OBII home"><ObiiLogo height={28} loading="eager" /></a>
			<nav aria-label="Primary navigation">
				<a href="#how">How it works</a>
				<a href="#experts">Experts</a>
				<a href="#companies">Companies</a>
				<a href="#pricing">Pricing</a>
				<a href="#faqs">FAQs</a>
			</nav>
			<div class="nav-actions">
				<a class="login" href={appLoginUrl}>Log in</a>
				<a class="button button-small" href={appRegisterUrl}>Try OBII free</a>
			</div>
			<button class="menu" type="button" aria-label="Open menu" aria-expanded="false"><span></span><span></span></button>
		</div>
		<div class="nav-panel" hidden>
			<a href="#how">How it works</a>
			<a href="#experts">Experts</a>
			<a href="#companies">Companies</a>
			<a href="#pricing">Pricing</a>
			<a href="#faqs">FAQs</a>
			<a href={appLoginUrl}>Log in</a>
			<a class="button button-small" href={appRegisterUrl}>Try OBII free</a>
		</div>
	</header>

	<main>
		<section class="hero">
			<div class="hero-glow glow-one"></div>
			<div class="hero-glow glow-two"></div>
			<div class="shell hero-grid">
				<div class="hero-copy">
					<p class="eyebrow light">OBII / EXPERT INVESTMENT INTELLIGENCE</p>
					<h1>Some decisions<br />deserve more than<br />a headline.</h1>
					<p class="hero-lead">You’ve spent years building your portfolio. Go beyond the headline when researching the shares you own.</p>
					<p class="hero-description">ausbiz lets you watch expert market interviews for free. OBII helps you discover what real experts said, understand their reasoning and check the original source.</p>
					<div class="hero-actions">
						<a class="button" href={appRegisterUrl}>Try OBII free for 7 days <span>→</span></a>
						<a class="text-link light-link" href="#example">See a real example <span>↓</span></a>
					</div>
					<p class="reassurance">7 days free <i></i> No credit card required <i></i> Start with a company you follow</p>
				</div>

				<div class="hero-visual" aria-label="Illustrative OBII product preview">
					<div class="portrait portrait-left">
						<div class="portrait-card">
							<Image
								src={nadinePortrait}
								alt="Nadine Blayney"
								width={540}
								height={540}
								class="portrait-img"
								loading="eager"
							/>
						</div>
						<div class="portrait-label"><strong>Nadine Blayney</strong><small>ausbiz · Editorial</small></div>
					</div>
					<div class="portrait portrait-right">
						<div class="portrait-card">
							<Image
								src={kochPortrait}
								alt='David "Kochie" Koch'
								width={540}
								height={540}
								class="portrait-img"
								loading="eager"
							/>
						</div>
						<div class="portrait-label"><strong>David “Kochie” Koch</strong><small>ausbiz</small></div>
					</div>
					<div class="product-window">
						<div class="window-top">
							<ObiiLogo class="mini-logo" height={16} loading="eager" />
							<div class="search">⌕ &nbsp; Search a company or expert</div>
							<span>•••</span>
						</div>
						<div class="window-body">
							<aside><b>Research</b><span>Home</span><span>Companies</span><span>Experts</span><span>Watchlists</span></aside>
							<div class="research-panel">
								<div class="company-head"><span class="ticker">BHP</span><div><b>BHP Group</b><small>ASX:BHP</small></div></div>
								<div class="tabs"><b>Overview</b><span>Expert views</span><span>Sources</span></div>
								<h3>Research the original record</h3>
								<p>Find source-linked expert commentary and view the original dated interview.</p>
								<div class="record-card"><span class="play" aria-hidden="true"><PlayArrowIcon /></span><div><b>Expert view on BHP</b><small>the call · 2 Nov 2026</small></div><span>→</span></div>
							</div>
						</div>
					</div>
					<div class="phone">
						<div class="phone-notch"></div>
						<ObiiLogo class="mini-logo phone-logo" height={12} loading="eager" />
						<div class="phone-card"><span>BHP</span><b>BHP Group</b><small>ASX:BHP</small></div>
						<p>Latest expert views</p>
						<div class="phone-line"></div><div class="phone-line short"></div>
					</div>
				</div>
			</div>
			<div class="shell proof-row">
				<div><span>01</span><b>Research your shares</b></div>
				<div><span>02</span><b>Real experts, real sources</b></div>
				<div><span>03</span><b>Return every few days</b></div>
			</div>
		</section>

		<div class="trust-strip">
			<div class="shell strip-inner">
				<AusbizLogo class="trust-ausbiz" height={24} />
				<p>Original market interviews and expert perspectives from ausbiz.</p>
				<strong>Hear it on ausbiz. Research it on OBII.</strong>
			</div>
		</div>

		<section class="section example" id="example">
			<div class="shell two-col">
				<div class="section-copy">
					<p class="eyebrow">A REAL EXAMPLE / BHP ON AUSBIZ</p>
					<h2>You follow BHP. What did the experts say?</h2>
					<p>On 2 November 2026, ausbiz discussed BHP on <em>the call</em>. OBII is designed to make this kind of commentary easier to research: find a view, explore the available reasoning and check the dated original recording.</p>
					<a class="button" href="#how">Explore the research journey <span>→</span></a>
				</div>
				<div class="media-card">
					<EpisodeVideoArt
						variant="index"
						href={episodeUrl}
						poster={episodePoster}
						videoSrc={episodeVideoSrc}
						alt="the call, 2 November 2026"
					/>
					<div class="media-info">
						<div><span class="ticker">BHP</span><p><b>BHP Group</b><small>ASX:BHP</small></p></div>
						<a href={episodeUrl} target="_blank" rel="noopener noreferrer">View original ausbiz programme ↗</a>
					</div>
				</div>
			</div>
			<div class="shell journey">
				<div><span>01</span><p><b>FIND</b>BHP expert views</p></div>
				<i>→</i>
				<div><span>02</span><p><b>UNDERSTAND</b>Available reasons & context</p></div>
				<i>→</i>
				<div><span>03</span><p><b>VERIFY</b>Original clip, dated 2 Nov</p></div>
			</div>
		</section>

		<section class="section compare-section">
			<div class="shell">
				<div class="center-heading">
					<p class="eyebrow">WHY PAY IF AUSBIZ IS FREE?</p>
					<h2>Watch it free.<br />Research it with OBII.</h2>
				</div>
				<div class="compare-grid">
					<article class="compare-card">
						<div class="card-brand logo-chip"><AusbizLogo height={20} /></div>
						<p class="card-label">FREE TO WATCH</p>
						<h3>Hear what the expert said.</h3>
						<p>Hear market guests discuss shares, market events and investment ideas.</p>
						<ul><li>Original market broadcasts and interviews</li><li>Journalists and guest commentators</li><li>A window into the market conversation</li></ul>
					</article>
					<article class="compare-card obii-card">
						<div class="card-brand logo-chip"><ObiiLogo height={20} /></div>
						<p class="card-label">PAID RESEARCH MEMBERSHIP</p>
						<h3>Research what it means for you.</h3>
						<p>Find past and new views by company or expert, save companies and check the original interview.</p>
						<ul><li>Search by company and named expert</li><li>Dated interview links and available reasoning</li><li>Watchlists, expert follows and research tools</li></ul>
					</article>
				</div>
				<p class="closing-line">You are not paying for the same broadcast again. <strong>You are paying for the tools to research it.</strong></p>
			</div>
		</section>

		<section class="steps-band" id="how">
			<div class="shell">
				<p class="eyebrow light">HOW OBII WORKS</p>
				<h2>Your shares.<br />Their expertise.<br />Your decision.</h2>
				<div class="steps-grid">
					<div><span>01</span><h3>FIND</h3><p>Search real market commentary on the companies and experts you already follow.</p></div>
					<div><span>02</span><h3>UNDERSTAND</h3><p>Go beyond a sound bite with the explanation and context available in the record.</p></div>
					<div><span>03</span><h3>VERIFY</h3><p>Check the date and original ausbiz recording before making up your own mind.</p></div>
				</div>
			</div>
		</section>

		<section class="section product-demo">
			<div class="shell two-col demo-grid">
				<div class="demo-window">
					<div class="demo-bar"><span>◇ OBII · RESEARCH EXPERIENCE</span><span>Search &nbsp; Sources</span></div>
					<div class="demo-search">⌕ &nbsp; Search company or expert <b>BHP</b></div>
					<div class="demo-result"><span class="ticker">BHP</span><div><b>BHP Group</b><small>ASX:BHP · Dated expert commentary and original source</small></div><span>→</span></div>
					<div class="flow-card">
						<b>BHP · From broadcast to research</b>
						<div class="flow"><span><i>1</i>FIND<small>Original expert commentary</small></span><span><i>2</i>UNDERSTAND<small>Reasoning and context</small></span><span><i>3</i>VERIFY<small>the call · 2 Nov 2026</small></span></div>
					</div>
				</div>
				<div class="section-copy">
					<p class="eyebrow">SEE HOW OBII HELPS YOU RESEARCH</p>
					<h2>Investment intelligence for the shares you follow.</h2>
					<div class="number-list">
						<div><span>01</span><p><b>Start with a company.</b> Research available expert views on a stock that matters to you.</p></div>
						<div><span>02</span><p><b>Go beyond the headline.</b> Explore the reasoning, context and perspectives available.</p></div>
						<div><span>03</span><p><b>Check the original source.</b> Open the dated interview and decide what matters.</p></div>
					</div>
				</div>
			</div>
			<div class="shell return-banner">
				<div><span>↻</span><p><b>Come back every few days. See what’s new on your shares.</b><small>Return to check for new commentary on the shares and experts you follow.</small></p></div>
				<a class="button" href={appRegisterUrl}>Try OBII free <span>→</span></a>
			</div>
		</section>

		<section class="section people-section" id="experts">
			<div class="shell">
				<div class="section-intro">
					<div><p class="eyebrow">REAL PEOPLE / REAL MARKET COVERAGE</p><h2>Real people behind<br />the market conversations.</h2></div>
					<p>ausbiz brings the interviews and market commentators. OBII makes that record easier to search and research, with dates and original sources you can inspect.</p>
				</div>
				<div class="people-grid">
					<article class="person-card">
						<div class="person-photo">
							<Image src={nadinePortrait} alt="Nadine Blayney" width={380} height={480} loading="lazy" />
						</div>
						<p class="card-label">AUSBIZ EDITORIAL</p><h3>Nadine Blayney</h3><p>Real broadcast journalism. Recognisable market coverage.</p>
					</article>
					<article class="person-card">
						<div class="person-photo">
							<Image src={kochPortrait} alt='David "Kochie" Koch' width={380} height={480} loading="lazy" />
						</div>
						<p class="card-label">AUSBIZ</p><h3>David “Kochie” Koch</h3><p>Part of the established ausbiz media business.</p>
					</article>
				</div>
				<div class="expert-list">
					<span>Gaurav Sodhi<small>Guest expert</small></span><span>Henry Jennings<small>Guest expert</small></span><span>Jun Bei Liu<small>Guest expert</small></span><span>Michael Gable<small>Guest expert</small></span>
				</div>
			</div>
		</section>

		<section class="section company-section" id="companies">
			<div class="shell">
				<div class="center-heading"><p class="eyebrow">REAL COMPANIES. REAL CONTEXT.</p><h2>Research begins with a<br />company, not another headline.</h2><p>Start with a company you follow. Find dated expert commentary, explore the context and return when new perspectives become available.</p></div>
				<div class="companies">
					{companies.map((company) => <article><span style={`--company-color:${company.color}`}>{company.ticker}</span><div><b>{company.name}</b><small>ASX:{company.ticker}</small></div><i>→</i></article>)}
				</div>
			</div>
		</section>

		<section class="section pricing-section" id="pricing">
			<div class="shell">
				<div class="center-heading"><p class="eyebrow">SIMPLE MONTHLY PLANS</p><h2>Try the intelligence.<br />Decide for yourself.</h2><p>Start with seven days free and no credit card. Choose a plan only if the research earns a place in your routine.</p></div>
				<div class="pricing-grid">
					<article class="price-card">
						<p class="card-label">STANDARD</p><h3>Focused research</h3><p>For a smaller group of companies and market experts.</p><div class="price"><sup>A$</sup>49<small>.00<br />/month</small></div><p class="gst">GST added at checkout</p>
						<ul><li>Searchable expert interviews</li><li>One watchlist of up to 10 companies</li><li>Follow up to 20 market experts</li><li>Limited research tools</li></ul>
						<a class="button outline" href={appRegisterUrl}>Try OBII free for 7 days <span>→</span></a>
					</article>
					<article class="price-card featured">
						<div class="flag">MORE RESEARCH CAPACITY</div>
						<p class="card-label">PRO</p><h3>Research with more range</h3><p>More watchlists, experts and research capacity.</p><div class="price"><sup>A$</sup>149<small>.00<br />/month</small></div><p class="gst">GST added at checkout</p>
						<ul><li>Searchable expert interviews</li><li>Four watchlists of up to 10 each</li><li>Follow unlimited market experts</li><li>Full listed research tools</li></ul>
						<a class="button" href={appRegisterUrl}>Try OBII free for 7 days <span>→</span></a>
					</article>
				</div>
			</div>
		</section>

		<section class="section reassurance-section">
			<div class="shell">
				<div class="center-heading"><p class="eyebrow">BEFORE YOU BEGIN</p><h2>Seven days to see if it’s useful to you.</h2><p>Explore the product first. Know the terms before choosing to subscribe.</p></div>
				<div class="reassurance-grid">
					<div><span>7</span><b>7 days free</b><p>Explore the experience before choosing a plan.</p></div>
					<div><span>◇</span><b>No card to start</b><p>No payment details required for the trial.</p></div>
					<div><span>✓</span><b>Choose to continue</b><p>Review features and pricing before subscribing.</p></div>
					<div><span>↗</span><b>Your own decision</b><p>General research information, not personalised advice.</p></div>
				</div>
			</div>
		</section>

		<section class="section faq-section" id="faqs">
			<div class="shell faq-grid">
				<div><p class="eyebrow">COMMON QUESTIONS</p><h2>Everything clear<br />before you begin.</h2><p>The more confidently you understand the research experience, the easier your next step should feel.</p></div>
				<div class="faq-list">
					{faqs.map(([question, answer], index) => <details open={index === 0}><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}
				</div>
			</div>
		</section>

		<section class="final-cta">
			<div class="shell final-inner">
				<div><p class="eyebrow light">REAL PEOPLE. ORIGINAL SOURCES.</p><h2>You’ve done the work to build your portfolio.<br />Make the research count.</h2><p>Find the commentary. Explore the thinking. Check the original source.</p></div>
				<div><a class="button" href={appRegisterUrl}>Try OBII free for 7 days <span>→</span></a><small>No credit card required to start.</small></div>
			</div>
		</section>
	</main>

	<footer>
		<div class="shell footer-top">
			<a class="logo" href="#"><ObiiLogo height={26} /></a>
			<nav><a href="#how">How it works</a><a href="#experts">Experts</a><a href="#companies">Companies</a><a href="#pricing">Pricing</a><a href="#faqs">FAQs</a></nav>
			<AusbizLogo class="footer-ausbiz" height={22} />
		</div>
		<div class="shell footer-bottom"><span>© 2026 OBII. General information only.</span><span>Terms &nbsp; Privacy &nbsp; Contact</span></div>
	</footer>
</Layout>

<style>
	.shell {
		box-sizing: border-box;
		width: min(100%, 1280px);
		max-width: 1280px;
		margin-inline: auto;
		padding-inline: 24px;
	}
	.section { padding: 108px 0; }
	.eyebrow { margin-bottom: 18px; color: #6d59f7; font-size: 11px; font-weight: 800; letter-spacing: .15em; }
	.eyebrow.light { color: #aaa4ff; }
	h1, h2, h3 { font-family: 'Manrope', sans-serif; letter-spacing: -.045em; }
	h2 { margin-bottom: 24px; font-size: clamp(38px, 4.1vw, 62px); line-height: 1.02; }
	p { color: var(--muted); line-height: 1.65; }
	.button { display: inline-flex; align-items: center; justify-content: center; gap: 28px; min-height: 50px; padding: 0 22px; border: 1px solid var(--purple); border-radius: 5px; color: white; background: var(--purple); font-size: 13px; font-weight: 700; text-decoration: none; box-shadow: 0 7px 18px rgba(92,70,237,.22); }
	.button span { font-size: 18px; }
	.button-small { min-height: 38px; padding: 0 16px; font-size: 11px; }
	.button.outline { color: var(--purple); background: white; box-shadow: none; }
	.logo { display: inline-flex; align-items: center; flex: 0 0 auto; line-height: 0; text-decoration: none; }
	:global(.obii-logo),
	:global(.ausbiz-brand) { display: block; width: auto; max-width: none; }
	.site-header { position: absolute; z-index: 30; width: 100%; border-bottom: 1px solid rgba(255,255,255,.13); color: white; }
	.site-header.is-open { background: #11105d; }
	.nav-wrap { display: flex; align-items: center; height: 68px; }
	.site-header nav { display: flex; align-items: center; gap: 34px; margin-left: 48px; }
	.site-header nav a, .login { color: #d8d7f3; font-size: 12px; text-decoration: none; }
	.nav-actions { display: flex; align-items: center; gap: 26px; margin-left: auto; }
	.menu { display: none; width: 42px; height: 42px; padding: 0; border: 0; background: none; cursor: pointer; }
	.menu span { display: block; width: 22px; height: 2px; margin: 5px auto; background: white; }
	.nav-panel { display: none; }

	.hero { position: relative; overflow: hidden; padding: 150px 0 38px; color: white; background: linear-gradient(122deg,#11105d 0%,#1f197c 50%,#20167a 100%); }
	.hero:before { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.026) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.026) 1px,transparent 1px); background-size: 54px 54px; content: ''; }
	.hero-glow { position: absolute; border-radius: 50%; filter: blur(3px); }
	.glow-one { top: -180px; right: -110px; width: 650px; height: 650px; background: radial-gradient(circle,rgba(123,76,255,.3),transparent 68%); }
	.glow-two { bottom: -300px; left: 30%; width: 600px; height: 600px; background: radial-gradient(circle,rgba(70,86,255,.22),transparent 68%); }
	.hero-grid { position: relative; display: grid; grid-template-columns: .94fr 1.2fr; gap: 70px; align-items: center; }
	.hero-copy { container-type: inline-size; }
	.hero h1 { margin-bottom: 24px; font-size: clamp(30px, min(11.5cqi, 9.2vw), 60px); line-height: .98; }
	.hero-lead { max-width: 510px; margin-bottom: 18px; color: white; font-size: 18px; line-height: 1.45; }
	.hero-description { max-width: 540px; color: #c8c7df; font-size: 14px; }
	.hero-actions { display: flex; align-items: center; gap: 32px; margin: 30px 0 18px; }
	.text-link { font-size: 13px; font-weight: 700; text-decoration: none; }
	.light-link { color: white; }
	.reassurance { display: flex; align-items: center; gap: 9px; color: #aaa9c9; font-size: 10px; }
	.reassurance i { width: 3px; height: 3px; border-radius: 50%; background: #8b83f8; }
	.hero-visual { position: relative; min-height: 640px; }
	.product-window { position: absolute; z-index: 2; right: 15px; bottom: 20px; width: 580px; height: 350px; overflow: hidden; border: 7px solid rgba(255,255,255,.94); border-radius: 12px; color: var(--ink); background: white; box-shadow: 0 35px 80px rgba(4,3,45,.45); transform: perspective(1000px) rotateY(-3deg); }
	.window-top { display: flex; align-items: center; gap: 12px; height: 43px; padding: 0 14px; color: white; background: #171366; font-size: 10px; }
	.mini-logo { flex: 0 0 auto; }
	.phone-logo { margin-top: 10px; }
	.window-top .search { flex: 1; padding: 8px 12px; border: 1px solid rgba(255,255,255,.18); border-radius: 4px; color: #aaa8ca; background: rgba(255,255,255,.08); }
	.window-body { display: grid; grid-template-columns: 105px 1fr; height: calc(100% - 43px); }
